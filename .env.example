# PostgreSQL
DATABASE_URL=postgresql://postgres:password@postgres:5432/finflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=finflow

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace-with-64-char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=replace_me
LEMONSQUEEZY_STORE_ID=replace_me
LEMONSQUEEZY_VARIANT_ID=replace_me
LEMONSQUEEZY_WEBHOOK_SECRET=replace_me

# Services
ML_SERVICE_URL=http://ml-service:8001
PORT=8080
FRONTEND_URL=http://localhost:3000
APP_ENV=development

# ─── Resend Email Service ──────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=FinFlow <onboarding@resend.dev>

# ─── Supabase Auth (Vercel & Local environment variables) ───────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Google reCAPTCHA v2 Checkbox ────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# Notification / Forms dispatch
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key
