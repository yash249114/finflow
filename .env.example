# ═══════════════════════════════════════════════════════════
# FinFlow — Environment Configuration
# ═══════════════════════════════════════════════════════════
# REQUIRED: Replace ALL placeholder values before deploying to production.
# NEVER commit this file with real secrets.
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/finflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password-32-chars-min
POSTGRES_DB=finflow

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=change-me-to-another-strong-password

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Lemon Squeezy ───────────────────────────────────
LEMONSQUEEZY_API_KEY=replace_me
LEMONSQUEEZY_STORE_ID=replace_me
LEMONSQUEEZY_VARIANT_ID=replace_me
LEMONSQUEEZY_WEBHOOK_SECRET=replace_me

# ── Services ────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
ML_API_KEY=replace-with-random-32-char-min
PORT=8080
FRONTEND_URL=http://localhost:3000
APP_ENV=development

# ── Resend Email Service ────────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=FinFlow <onboarding@resend.dev>

# ── Supabase Auth ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Google reCAPTCHA v2 ─────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# ── AI Providers (Optional) ─────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AIOps (Self-healing / Self-monitoring) ──────────
TELEMETRY_STREAM=finflow:telemetry
ALERT_EMAIL_FROM=aiops@finflow.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
GITHUB_TOKEN=
GITHUB_OWNER=yash249114
GITHUB_REPO=finflow
AIOPS_OWNER_EMAIL=

# ── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key
NEXT_PUBLIC_ADMIN_EMAIL=

# ── E2E Test OTP Auto-Confirm ───────────────────────
# Set to "1" ONLY in test environments to enable the test-only
# /api/e2e/confirm-signup endpoint that auto-confirms signup OTP via the
# Supabase admin API. Leave unset (or "0") in production — the endpoint
# returns 404 otherwise.
E2E_OTP_AUTO=0
