# ═══════════════════════════════════════════════════════════
# FinFlow API — Backend Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy to .env and replace ALL placeholder values.
# NEVER commit .env with real secrets.
# ═══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── PostgreSQL (REQUIRED) ────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/finflow

# ── Redis (REQUIRED for AIOps & caching) ─────────────
REDIS_URL=redis://default:password@localhost:6379

# ── JWT (REQUIRED) ──────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string-minimum
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── ML Service ──────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
ML_API_KEY=replace-with-random-32-char-min

# ── Frontend ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Razorpay (Billing — all 3 required or billing is disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI Providers (Optional — AI Copilot falls back if missing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Security (Optional) ─────────────────────────────
RECAPTCHA_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AIOps: SMTP (Optional — email alerts disabled when missing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=aiops@finflow.ai
ALERT_EMAIL_TO=

# ── AIOps: GitHub (Optional — auto-created issues disabled when missing)
GITHUB_TOKEN=
GITHUB_OWNER=yash249114
GITHUB_REPO=finflow

# ── AIOps: Owner (Optional — escalation email)
AIOPS_OWNER_EMAIL=

# ── AIOps: Web3Forms (Optional — support tickets)
WEB3FORMS_KEY=

# ── AIOps: Telemetry (Optional — defaults below)
TELEMETRY_STREAM=finflow:telemetry
QUOTA_REFRESH_MINUTES=5
